DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flashx
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=bid_qa
QDRANT_VECTOR_SIZE=512
QDRANT_TIMEOUT=30
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=chatbot
TAVILY_API_KEY=
EXA_API_KEY=
LLM_PROVIDER=deepseek
API_HOST=0.0.0.0
API_PORT=8001
CORS_ORIGINS=
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=deepseek-r1-0528-qwen3-8b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=deepseek-r1:8b
HF_TOKEN=
HF_ENDPOINT=https://hf-mirror.com
# 鉴权密钥 (JWT 签名; 未配置 PROFILE_ENC_KEYS 时也用于派生企业资料敏感字段加密密钥)
AUTH_SECRET=
# R10 企业资料敏感字段加密密钥链: 逗号分隔多个 Fernet key,
# 第一个=当前加密密钥, 其余=历史密钥(仅用于解密旧密文, 支持无停机轮换)
# 生成新密钥: python -m src.tools.field_crypto gen-key
# 轮换重加密: python -m src.tools.field_crypto rotate --dry-run 确认后再正式执行
# 留空=由 AUTH_SECRET 经 PBKDF2 派生 (存量密文零迁移)
PROFILE_ENC_KEYS=
# R11 证书原件存储: local(默认, 本地磁盘 uploads/certs) | s3(AWS S3 / MinIO 兼容)
CERT_STORAGE_TYPE=local
CERT_S3_BUCKET=bid-certs
CERT_S3_PREFIX=certs/
# MinIO/自建 S3 网关地址 (AWS 留空); path-style + s3v4 签名自动适配
CERT_S3_ENDPOINT=
CERT_S3_REGION=
CERT_S3_ACCESS_KEY=
CERT_S3_SECRET_KEY=
CERT_S3_AUTO_BUCKET=true
CERT_S3_PRESIGN_MIN=10
